# =====================================================================
# Next.js frontend configuration
#
# Only variables prefixed NEXT_PUBLIC_ are embedded in the browser
# bundle, so nothing secret may live here.
# =====================================================================

# Base URL of the FastAPI backend. The browser calls this directly.
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket endpoint for live dashboard updates. The client appends
# its JWT as a `token` query parameter.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/dashboard
