# =====================================================================
# Smart Exam Proctoring — environment configuration
#
# Copy to `.env` (root) for the backend and AI service, and to
# `frontend/.env.local` for the Next.js build.
#
# Values here are LOCAL DEVELOPMENT defaults. Change every secret before
# deploying anywhere reachable from a network.
# =====================================================================

# ---------------------------------------------------------------------
# Backend — authentication
# ---------------------------------------------------------------------
# Used to sign the JWTs. MUST be long and random in production; the
# fallback in config.py is a publicly known string and is only here so
# a fresh checkout runs out of the box.
SECRET_KEY=4c1d8c9841423f06e7cd90d1da9358645a385e0545fa5ead80c9a4d32b446023

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=2

# ---------------------------------------------------------------------
# Backend — storage
# ---------------------------------------------------------------------
# SQLite for development. For Postgres use:
#   postgresql+asyncpg://user:password@localhost:5432/smart_exam
# (the `asyncpg` driver is already in requirements.txt)
DATABASE_URL=sqlite+aiosqlite:///./smart_exam.db

# Where violation-evidence frames are written and served from.
EVIDENCE_DIR=./evidence

# ---------------------------------------------------------------------
# Backend — bootstrap admin (TRANSITION-ONLY mock login)
# ---------------------------------------------------------------------
# This is the single permitted mock-login exception. It is provisioned
# once on first boot and never reset afterwards, so rotating the values
# here only affects a fresh database.
# Delete this block once a real admin account has been provisioned.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345678
BOOTSTRAP_ADMIN_EMAIL=admin@smartexam.edu

# ---------------------------------------------------------------------
# Device credentials — AI pipeline / robot
# ---------------------------------------------------------------------
# The pipeline authenticates with these (X-Device-Code / X-Device-Key),
# entirely separately from invigilator login. The key must satisfy the
# backend password policy: >=12 chars with upper, lower, digit, symbol.
# It is stored hashed; the plaintext is shown once when provisioned.
ROBOT_DEVICE_CODE=ROBOT-01
ROBOT_DEVICE_KEY=Robot-Dev-Key-2026!

# A device is treated as offline when it has not heartbeated within
# this window. Cameras go `offline` (never `online`) past it.
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------
# AI pipeline
# ---------------------------------------------------------------------
# Where the pipeline posts events. Use `http://backend:8000` under
# Docker Compose, `http://localhost:8000` when running bare-metal.
BACKEND_URL=http://localhost:8000

# Camera index to open (0 = default webcam).
CAMERA_INDEX=0

# Registered camera device codes this pipeline feeds, comma-separated.
# Leave empty to report only the device itself (fine for one camera).
CAMERA_CODES=ROBOT-01-CAM0

# Show the OpenCV preview window. Set false on headless servers.
DISPLAY_GUI=false
